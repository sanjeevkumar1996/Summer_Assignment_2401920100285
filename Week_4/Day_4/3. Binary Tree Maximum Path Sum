class Solution {
public:
    int m = INT_MIN;
    int dfs(TreeNode* root) {
        if (root == NULL){
            return 0;
        }
        int l = max(0, dfs(root->left));
        int r = max(0, dfs(root->right));
        m = max(m, root->val + l + r);
        return root->val + max(l, r);
    }
    int maxPathSum(TreeNode* root) {
        dfs(root);
        return m;
    }
};
