class Solution {
public:
    vector<vector<int>> levelOrder(TreeNode* root) {
        vector<vector<int>>a;
        if(root==NULL) {
        return a;
        }
        queue<TreeNode*>q;
        q.push(root);
        while(!q.empty()) { 
        int s=q.size();
        vector<int>l;
            for(int i=0;i<s;i++)
            {   TreeNode* node=q.front();
                l.push_back(node->val);
                q.pop();
                if(node->left!=NULL) q.push(node->left);
                  if(node->right!=NULL) q.push(node->right);     
            }
            a.push_back(l);
        }
        return a;
    }
};
