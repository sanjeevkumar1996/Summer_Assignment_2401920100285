class Solution {
public:
    vector<vector<int>> zigzagLevelOrder(TreeNode* root) {
       vector<vector<int>>a;
       if(root==NULL) {
       return a;
       }
       queue<TreeNode*>q;
       bool zigzag=false;
       q.push(root);
       int p;
       while(!q.empty())
       { 
        int s=q.size();
        vector<int>t(s);
        for(int i=0;i<s;i++)
        {  
            TreeNode* node= q.front();
            q.pop();
        if(zigzag)
        {
             p=s-i-1;
        }
        else
        {
            p=i;
        }
        t[p]=node->val;
        if(node->left)
        {
            q.push(node->left);
        }
        if(node->right) q.push(node->right);
        }
        zigzag=!zigzag;
        a.push_back(t);
       }
       return a; 
    }
};
