class Solution {
public:
    int maxSubArray(vector<int>& nums) {
        int n=nums.size();
        int m=INT_MIN;
        int p=0;
        for(int i=0;i<n;i++){
            p=p+nums[i];
            m=max(m,p);
            if(p<0){
                p=0;
            }
        }
        return m;
    }
};
