  class Solution {
public:
    double findMaxAverage(vector<int>& nums, int k) {
        int n=nums.size();
        double ans=0;
        double w=0;
        for(int i=0;i<k;i++){
            w=w+nums[i];
        }
        ans=w/k;
        for(int j=k;j<n;j++){
            w=w+nums[j]-nums[j-k];
            ans=max(ans,w/k);
        }
        return ans;
    }
};
