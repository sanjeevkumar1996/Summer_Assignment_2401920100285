class Solution {
public:
    vector<int> twoSum(vector<int>& nums, int target) {
        vector<int> answer;
        int n = nums.size();
        for (int i=0;i<n-1;i++) {
            int a = nums[i];
            for (int j = i+1;j<n;j++) {
                int b = nums[j];
                if (a + b == target) {
                    answer.push_back(i);
                    answer.push_back(j);
                    return answer;
                }
            }
        }
        return answer;
    }
};
