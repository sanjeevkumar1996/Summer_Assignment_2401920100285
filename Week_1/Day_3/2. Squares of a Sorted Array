class Solution {
public:
    vector<int> sortedSquares(vector<int>& nums) {
        int n=nums.size();
        vector<int>ans(n);
        int j=0;
        int k=n-1;
        for(int i=n-1;i>=0;i--){
            if(abs(nums[j])>nums[k]){
                ans[i]=nums[j]*nums[j];
                j++;
            }
            else{
                ans[i]=nums[k]*nums[k];
                k--;
            }
        }
        return ans;
    }
};
