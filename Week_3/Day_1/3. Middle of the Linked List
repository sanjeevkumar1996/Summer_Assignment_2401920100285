class Solution {
public:
    ListNode* middleNode(ListNode* head) {
        if (head==nullptr || head->next==nullptr) return head;
        ListNode* s=head;
        ListNode* f=head;
        while (f!= nullptr && f->next != nullptr) {
            s=s->next;
            f=f->next->next;
        }
        return s;
    }
};
