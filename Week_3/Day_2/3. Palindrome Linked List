class Solution {
public:
    bool isPalindrome(ListNode* head) {
        if (head == NULL || head->next == NULL)
            return true;
        ListNode* s=head;
        ListNode* f=head;
        while (f!= NULL && f->next != NULL) {
            s=s->next;
            f= f->next->next;
        }
        ListNode* p= NULL;
        ListNode* c= s;
        while (c!= NULL) {
            ListNode* n= c->next;
            c->next = p;
            p=c;
            c=n;
        }
        ListNode* first = head;
        ListNode* sec=p;
        while (sec!= NULL) {
            if (first->val != sec->val)
                return false;
            first = first->next;
            sec=sec->next;
        }
        return true;
    }
};
