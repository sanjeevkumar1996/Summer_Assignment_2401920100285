class Solution {
public:
    int largestRectangleArea(vector<int>& heights) {
        stack<int> s;
        int n = heights.size();
        int maxA = 0;
        for (int i = 0; i <= n; i++) {
            while (!s.empty() && (i == n || heights[s.top()] > heights[i])) {
                int height = heights[s.top()];
                s.pop();
                int w;
                if (s.empty())
                    w = i;
                else
                    w = i - s.top() - 1;

                maxA = max(maxA, height * w);
            }
            s.push(i);
        }

        return maxA;
    }
};
