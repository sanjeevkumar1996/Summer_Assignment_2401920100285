class Solution {
public:
    bool canConstruct(string ransomNote, string magazine) {
        vector<int>f1(26,0);
        vector<int>f2(26,0);
        for(char c:ransomNote){
            f1[c-'a']++;
        }
        for(char c:magazine){
            f2[c-'a']++;
        }
        for(int i=0;i<26;i++){
            if(f2[i]<f1[i]){
                return false;
            }
        }
        return true;
    }
};
