class Solution
{
public:
    int compress(vector<char> &chars)
    {
        int n=chars.size();
        int i=0,k=0;
        while (i<n)
        {
            int j=i;
            while (j<n&&chars[j]==chars[i])
            {
              j++;
            }
            int c=j-i;
            chars[k++]=chars[i];
            if (c>1)
            {
                string s=to_string(c);
                for(char c:s)
                {
                    chars[k++]=c;
                }
            }
            i=j;
        }
        return k;
    }
};
