class Solution {
public:
    int lengthOfLongestSubstring(string s) {
       int n=s.length();
       vector<int>c(256,0);
       int f=0,sec=0,l=0;
       while(sec<n){
        while(c[s[sec]]){
            c[s[f]]=0;
            f++;
        }
        c[s[sec]]=1;
        l=max(l,sec-f+1);
        sec++;
       }
       return l;
    }
};
