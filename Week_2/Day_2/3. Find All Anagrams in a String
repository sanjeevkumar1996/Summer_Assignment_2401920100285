class Solution {
public:
    vector<int> findAnagrams(string s, string p) {
        int n=s.length();
        int m=p.length();
        vector<int>ans;
        if(m>n){
            return ans;
        }
        vector<int>f1(26,0);
        vector<int>f2(26,0);
        for(int i=0;i<m;i++){
            f2[p[i]-'a']++;
            f1[s[i]-'a']++;
        }
        if(f1==f2){
            ans.push_back(0);
        }
        for(int i=m;i<n;i++){
            f1[s[i]-'a']++;
            f1[s[i-m]-'a']--;
            if(f1==f2){
                ans.push_back(i-m+1);
            }
        }
        return ans;
    }
};
